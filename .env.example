# Puerto donde se publica la app en el servidor (http://IP_DEL_SERVIDOR:8085)
APP_PORT=8085

POSTGRES_USER=igmrancho
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=igmrancho

# Acceso al panel /admin
ADMIN_USER=teletubi
ADMIN_PASSWORD=cambia-esta-clave
# Cadena larga y aleatoria: openssl rand -hex 32
JWT_SECRET=cambia-esto

EMAIL_DOMAIN=geograficomilitar.gob.ec
TZ_APP=America/Guayaquil

# Google Drive (opcional; sin esto las capturas quedan solo en el servidor)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Déjalo vacío: la app crea "IGM Rancho" en Mi unidad y recuerda su ID (puedes moverla después).
# Solo sirve el ID de una carpeta creada por la propia app (permiso drive.file).
DRIVE_ROOT_FOLDER_ID=

# --- Solo en el servidor ---
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
# COMPOSE_PROFILES=tunel
# Token del túnel "igm-rancho" (Cloudflare Zero Trust → Networks → Tunnels)
CLOUDFLARE_TUNNEL_TOKEN=
